---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout>

    <div class="pb-12 mt-5">
      <div class="text-xl py-1">Que tal 👋</div>
      <div class="text-5xl font-bold">aquí JackAndrewG</div>
      <div class="text-3xl py-3 font-bold">Ingeniero de software</div>
      <div class="py-2">
        <text class="text-lg">
            Como ingeniero de software, lo que más disfruto de trabajar en este campo es la constante oportunidad de aprendizaje y crecimiento. La naturaleza en constante evolución de la tecnología asegura que siempre haya nuevos lenguajes, frameworks y herramientas por explorar. Encuentro una inmensa satisfacción en mantenerme al día con las últimas tendencias y en esforzarme por adquirir nuevas habilidades. El proceso de diseñar y desarrollar sistemas de software, ya sea creando una aplicación web, construyendo una app móvil o implementando algoritmos complejos, me emociona. Me encanta el desafío de resolver problemas y encontrar soluciones elegantes para mejorar la eficiencia, escalabilidad y experiencia del usuario. Además, colaborar con equipos diversos y ser parte de un esfuerzo colectivo para crear software innovador e impactante es realmente gratificante. La naturaleza dinámica y de ritmo rápido del campo de la ingeniería de software me mantiene comprometido y motivado para mejorar continuamente y ofrecer soluciones de alta calidad.
          </text
        >
      </div>
      <div class="mt-8">
        <a class="btn" href="https://www.linkedin.com/in/jack-guzman/" target="_blank">Conectemos!</a>
        <a href="mailto:jackandrewg@gmail.com" target="_blank" class="btn btn-outline ml-5"> Contácteme por email</a>
      </div>
    </div>

    <div>
      <div class="text-3xl w-full font-bold mb-2">Mis últimos proyectos {"</>"}</div>
    </div>

    <HorizontalCard
      title="Jobs · JXBS"
      img="/my-portfolio/jobs-jxbs.webp"
      desc="Liderazgo técnico en una plataforma de selección de candidatos con IA. Consultas MongoDB, colaboración con el equipo de IA sobre Amazon Bedrock, mejoras en Next.js/React y QA."
      url="/my-portfolio/projects/jobs/"
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
    title="El Hornero · Back office"
    img="/my-portfolio/el-hornero-cover.webp"
    desc="Desarrollo y adaptación del back office con PHP y Laravel: análisis de la plantilla empresarial, configuración de cuentas y permisos, y ajustes a las necesidades del cliente."
    url="/my-portfolio/projects/el-hornero/"
    target="_self"
  />
    <div class="divider my-0"></div>
    <HorizontalCard
    title="El Corral"
    img="/my-portfolio/el-corral.webp"
    desc="Liderazgo técnico en la culminación del e-commerce, acompañando al equipo en el análisis de arquitectura backend y sus integraciones vigentes."
    url="/my-portfolio/projects/el-corral/"
    target="_self"
  />
    <div class="divider my-0"></div>
    <HorizontalCard
    title="Mi Mall DK"
    img="/my-portfolio/mi-mall-dk.webp"
    desc="Dirección de funcionalidades de reserva de parqueaderos en una app React Native. Gestión de tickets, revisión de PR, contratos API, diagramas de arquitectura y validación de QA."
    url="/my-portfolio/projects/mi-mall-dk/"
    target="_self"
  />
    <div class="divider my-0"></div>
    <HorizontalCard
    title="Turnero QR para Multicines"
    img="/my-portfolio/multicines-turnero.webp"
    desc="Desarrollo de un sistema de turnos con validación QR, prevención de duplicados y pantalla pública actualizada con Supabase Realtime, alertas visuales y sonoras."
    url="/my-portfolio/projects/multicines/"
    target="_self"
  />
    <div class="divider my-0"></div>
    <HorizontalCard
    title="Oracle Simphony POS · SushiCorp"
    img="/my-portfolio/sushicorp-simphony.webp"
    desc="Integración del POS con la web y app de SushiCorp: sincronización de menús y locales, inyección de órdenes, OAuth 2.0, webhooks, colas e idempotencia con DynamoDB."
    url="/my-portfolio/projects/sushicorp-simphony/"
    target="_self"
  />

    <a class="btn btn-outline mt-6" href="/my-portfolio/projects/">Ver todos los proyectos</a>


    <div>
      <div class="text-3xl w-full font-bold mb-5 mt-10">Lo nuevo en el blog</div>
    </div>

    {
      last_posts.map((post) => (
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={`${import.meta.env.BASE_URL}blog/` + post.slug}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0"></div>
      ))
    }

</BaseLayout>
