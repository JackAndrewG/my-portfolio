---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Servicios ofertados</div>
  </div>

  <HorizontalCard
    title="Scrum Master"
    img="/my-portfolio/scrum_master.png"
    desc= "Liderazgo de equipos de desarrollo, implementación de metodologías ágiles, aseguramiento de la calidad y entrega de proyectos en tiempo y forma."
    badge="Jira, Scrum, Agile"
  />
  <HorizontalCard
    title="Backend Developer"
    img="/my-portfolio/backend.png"
    desc="Desarrollo de micro-servicios, APIs, lógica de servidores, conexiones con bases de datos e integración con servicios de terceros"
    badge="Node, Django, Lambdas, NestJS, Spring Boot"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Frontend Developer"
    img="/my-portfolio/frontend.png"
    desc="Desarrollo de sitios web single page application (SPA), server side render (SSR), landing pages, e-commerce."
    badge="Vue, React, Angular, Supabase, Django"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Mobile Developer"
    img="/my-portfolio/mobile_development.png"
    desc="Desarrollo de aplicaciones móviles para android & iOS."
    badge="Dart, Flutter, React Native"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Database Manager"
    img="/my-portfolio/database_manager.png"
    desc="Arquitectura de bases de datos, mantenimiento, querying, triggering, functions"
    badge="MongoDB, PostgreSQL, MySQL, DynamoDB, Redis"
  />
  <HorizontalCard
    title="Cloud Engineer"
    img="/my-portfolio/cloud.png"
    desc="despliegue de servicios en la nube, configuración de servidores y servicios en la nube."
    badge="Linux Server, Google Cloud, AWS Cloud"
  />
  <div>
    <div class="text-3xl w-full font-bold mb-5">Lenguajes de programación dominados</div>
  </div>

  <div class="code-window" aria-label="Ejemplo de código animado">
    <div class="code-window-bar"><span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span><span class="code-window-title">greetings.js · Python</span></div>
    <pre id="code-container" aria-live="polite"></pre>
  </div>
  <script src=`${import.meta.env.BASE_URL}/codeWritter.js` is:inline></script>
</BaseLayout>

<style>
  .code-window { position: relative; margin: 1.25rem 0 2rem; overflow: hidden; border: 1px solid #263142; border-radius: .8rem; background: #0f172a; box-shadow: 0 18px 35px #0f172a2e; }
  .code-window-bar { display: flex; align-items: center; gap: .45rem; padding: .65rem .9rem; background: #1e293b; color: #94a3b8; font: 600 .8rem/1 system-ui, sans-serif; }
  .code-window-title { margin-left: .5rem; letter-spacing: .02em; }
  .dot { width: .7rem; height: .7rem; border-radius: 50%; }
  .dot-red { background: #fb7185; } .dot-yellow { background: #fbbf24; } .dot-green { background: #34d399; }
  #code-container { position: relative; min-height: 8rem; margin: 0; padding: 1.25rem 1.4rem 1.25rem 3.6rem; color: #e2e8f0; font: 500 1rem/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; }
  #code-container::before { content: "01\A02\A03\A04"; position: absolute; top: 1.25rem; left: 1.4rem; color: #475569; font-size: .72rem; line-height: 1.7; letter-spacing: .08em; white-space: pre; }
  :global(.function-keyword) { color: #c084fc; } :global(.parentheses), :global(.curly-braces) { color: #fbbf24; } :global(.console-keyword) { color: #38bdf8; } :global(.log-keyword) { color: #4ade80; }
</style>